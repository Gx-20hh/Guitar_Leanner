#pragma once

// Guitar Learner WebView2 宿主（T7 host 修复）
// 锁定 JUCE 9.0.3：withBackend(webview2) / withNativeIntegrationEnabled /
// withNativeFunction("guitarBridge", ...) / withResourceProvider。
// 用 getResourceProviderRoot() 加载打包页面，严格限制资源根与导航，不暴露 shell/任意文件。
//
// 线程约定：WebViewHost 主线程构造；回调/加载只在 UI 线程。

#include <juce_gui_extra/juce_gui_extra.h>
#include <juce_gui_basics/juce_gui_basics.h>

#include <optional>

namespace guitar_learner {

// 严格资源路径解析（纯函数，可独立单测）。
// 输入：信任的资源根目录 + provider 收到的请求路径（形如 "/"、"/assets/x.js" 或任意串）。
// 输出：root 内一个真实文件的绝对路径；解析失败返回空并填 error（不跟随越界/畸形路径）。
struct ResourceResolution
{
    bool ok = false;
    juce::File file;          // ok=true 时有效：root 内文件
    juce::String error;       // ok=false 时的人读错误（ASCII，诊断用）
};

class WebViewHost : public juce::Component
{
public:
    WebViewHost();

    // 若本机 WebView2 runtime 缺失（areOptionsSupported 返回 false），显示明确错误。
    bool isRuntimeAvailable() const;
    juce::String runtimeStatus() const;
    void resized() override;

    // 资源路径解析（严格）：root 必须绝对路径；requestPath 前导 "/" 剥掉；
    // "/" 或空映射 index.html；拒绝绝对盘符路径、含 ".." 段、sibling-prefix 逃逸、空段注入。
    static ResourceResolution resolveResourcePath (const juce::File& root, const juce::String& requestPath);

private:
    // 资源根：默认 exe 旁 ui/ 目录（构建时已复制 frontend/dist）。
    juce::File uiDir() const;

    // bridge：guitarBridge(request) Promise。
    void handleNativeFunction (const juce::Array<juce::var>& args,
                               juce::WebBrowserComponent::NativeFunctionCompletion completion);

    // 页面加载钩子：只允许资源根 URL，拒绝外部导航/新窗口。
    bool pageAboutToLoad (const juce::String& url) override;
    void newWindowAttemptingToLoad (const juce::String& url) override;

    std::unique_ptr<juce::WebBrowserComponent> browser_;
    juce::Label statusLabel_;
    juce::String resourceRootUrl_; // getResourceProviderRoot() 的值，用于校验加载来源
};

} // namespace guitar_learner
